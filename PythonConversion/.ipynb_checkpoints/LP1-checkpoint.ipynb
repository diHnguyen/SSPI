   "source": [
    "import gurobi as gp\n",
    "\n",
    "m = gp.Model()\n",
    "m.setParam(GRB.Param.OutputFlag, 0)\n",
    "x = m.addVar(vtype=GRB.BINARY, name=\"x\")\n",
    "y = m.addVar(vtype=GRB.BINARY, name=\"y\")\n",
    "m.setObjective(x+y,sense=GRB.MAXIMIZE)\n",
    "\n",
    "\n",
    "con1 = m.addConstr(x+y <= 2)\n",
    "con2 = m.addConstr(x+y <= 4)\n",
    "\n"
   ]
  }
 ],
